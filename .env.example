# Copy this file to .env.local for local development and fill in values as
# integrations are actually built. Every variable here is currently unused -
# the site runs with no external services.
#
# Rules:
#   - Never commit .env.local or any real secret. .env* is git-ignored.
#   - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#   - Never put a secret behind the NEXT_PUBLIC_ prefix.

# --- Database (order storage) - server only ---
# Needed only once order persistence is implemented.
# DATABASE_URL="postgres://user:password@host:5432/jos_grill"

# --- Payments (server only) ---
# Needed only once online payment is implemented.
# PAYMENT_SECRET_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# --- Payments (browser-safe public key) ---
# NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=""
