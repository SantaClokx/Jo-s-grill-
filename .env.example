# Copy this file to .env.local for local development and fill in values as
# integrations are actually built. Every variable here is currently unused -
# the site runs with no external services.
#
# Rules:
#   - Never commit .env.local or any real secret. .env* is git-ignored.
#   - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#   - Never put a secret behind the NEXT_PUBLIC_ prefix.

# --- Authentication (Clerk) ---
# Clerk is the only supported authentication provider. Both keys are required
# before the admin area will accept anyone; without them admin access is denied
# with an explicit error and the public site keeps working.
#
# Get these from the Clerk Dashboard: https://dashboard.clerk.com -> API keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is public by design and safe in the browser.
# CLERK_SECRET_KEY is a secret: server-only, never prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Optional: where Clerk sends signed-out users for the admin area.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Database (Neon PostgreSQL) - server only ---
# Order storage. Server-only: never prefixed NEXT_PUBLIC_.
#
# Use the Neon **pooled** connection string (the host contains "-pooler").
# Vercel functions are short-lived and open many connections; the pooler
# absorbs them and keeps the database from running out of slots.
#
# Format (placeholder only - never commit a real value):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# Migrations are applied with: npm run db:migrate
# The same variable is used for local development and for the deployment.

# --- Payments (server only) ---
# Needed only once online payment is implemented.
# PAYMENT_SECRET_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# --- Payments (browser-safe public key) ---
# NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=""
